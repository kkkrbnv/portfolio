---
import photos from '../data/photos.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photography | Arslan Kurbanov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
</head>
<body class="bg-black text-white font-['Inter',sans-serif] overflow-hidden">
    
    <nav class="fixed top-0 z-50 flex w-full justify-between p-8 mix-blend-difference items-center">
        <a href="/" class="text-[10px] uppercase tracking-[0.4em] font-black border border-white/10 px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all uppercase">← Back</a>
        <span class="text-xl font-black italic tracking-tighter uppercase leading-none italic">ARSLAN KURBANOV</span>
    </nav>

    <main class="flex h-screen items-center overflow-x-auto overflow-y-hidden px-20 gap-12 snap-x snap-mandatory scroll-smooth">
        {photos.map((photo) => (
            <div class="flex-none h-[70vh] snap-center cursor-zoom-in group relative" onclick={`openModal('${photo.src}', '${photo.description}')`}>
                <img src={photo.src} class="h-full w-auto object-cover rounded-xl transition-all duration-700 group-hover:scale-[1.02]" loading="lazy" />
                <p class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition-all text-[8px] tracking-[0.5em] uppercase bg-black/40 px-2 py-1 rounded">Expand</p>
            </div>
        ))}
    </main>

    <div id="modal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl hidden flex-col items-center justify-center p-6 cursor-zoom-out" onclick="closeModal()">
        <img id="modal-img" src="" class="max-h-[80vh] max-w-[85vw] object-contain rounded-lg shadow-2xl transition-all duration-500 scale-95" />
        <p id="modal-desc" class="mt-8 text-[10px] uppercase tracking-[0.4em] text-zinc-400 text-center max-w-2xl leading-relaxed italic"></p>
    </div>

    <script is:inline>
        function openModal(src, desc) {
            const modal = document.getElementById('modal');
            const img = document.getElementById('modal-img');
            img.src = src;
            document.getElementById('modal-desc').innerText = desc;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => img.classList.remove('scale-95'), 10);
        }
        function closeModal() {
            const modal = document.getElementById('modal');
            const img = document.getElementById('modal-img');
            img.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 300);
        }
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });
    </script>

    <style>
        ::-webkit-scrollbar { height: 2px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #1a1a1a; }
        main { scrollbar-width: thin; scrollbar-color: #1a1a1a transparent; }
    </style>
</body>
</html>
