---
import seriesData from '../data/photos.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photography | Arslan Kurbanov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
</head>
<body class="bg-[#050505] text-white font-['Inter',sans-serif] overflow-x-hidden selection:bg-white selection:text-black">
    
    <!-- Навигация -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-6 md:p-10 mix-blend-difference items-center">
        <a href="/" class="text-[10px] uppercase tracking-[0.4em] font-black border border-white/10 px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all">← Back</a>
        <span class="text-xl font-black italic tracking-tighter uppercase italic opacity-40">AK Photography</span>
    </nav>

    <main class="w-full pt-40 pb-20">
        {seriesData.map((series) => (
            <div class="mb-40">
                <!-- Название серии (слева) -->
                <div class="px-6 md:px-20 mb-10 overflow-visible">
                    <span class="text-[9px] uppercase tracking-[0.8em] text-zinc-600 block mb-2">{series.location}</span>
                    <h2 class="text-[clamp(3rem,8vw,10rem)] font-black uppercase italic tracking-tighter pearl-text leading-none pr-10">
                        {series.seriesTitle}{'\u00A0'}
                    </h2>
                </div>

                <!-- Список фото в серии -->
                <div class="flex flex-col items-center gap-20 md:gap-40">
                    {series.photos.map((photo) => (
                        <div 
                            class="w-full max-w-6xl px-4 flex justify-center content-auto" 
                            style="content-visibility: auto;"
                        >
                            <div class="relative group cursor-zoom-in" onclick={`openModal('${photo.src}', '${photo.description}')`}>
                                <img 
                                    src={photo.src} 
                                    class="max-h-[90vh] md:max-h-[110vh] w-auto object-contain rounded-sm shadow-2xl transition-all duration-1000 group-hover:scale-[1.01]" 
                                    loading="lazy"
                                    decoding="async"
                                />
                                {photo.description && (
                                    <div class="absolute bottom-4 left-4 opacity-0 group-hover:opacity-100 transition-opacity bg-black/50 backdrop-blur-md px-3 py-1 rounded-full border border-white/5">
                                        <p class="text-[8px] uppercase tracking-widest text-zinc-300 font-medium">{photo.description}</p>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </main>

    <!-- Увеличение (Modal) -->
    <div id="modal" class="fixed inset-0 z-[100] bg-black/98 backdrop-blur-2xl hidden flex-col items-center justify-center p-4 cursor-zoom-out" onclick="closeModal()">
        <img id="modal-img" src="" class="max-h-[85vh] max-w-[90vw] object-contain shadow-2xl transition-all duration-500 scale-95" />
        <p id="modal-desc" class="mt-8 text-[10px] uppercase tracking-[0.4em] text-zinc-500 text-center max-w-xl italic pr-10 overflow-visible"></p>
    </div>

    <script is:inline>
        function openModal(src, desc) {
            const modal = document.getElementById('modal');
            const img = document.getElementById('modal-img');
            img.src = src;
            document.getElementById('modal-desc').innerText = desc + '\u00A0';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            setTimeout(() => img.classList.remove('scale-95'), 10);
        }
        function closeModal() {
            const modal = document.getElementById('modal');
            const img = document.getElementById('modal-img');
            img.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 300);
        }
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });
    </script>

    <style is:global>
        .pearl-text { background: linear-gradient(to right, #333 20%, #888 40%, #fff 50%, #888 60%, #333 80%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 12s linear infinite; display: inline-block; }
        @keyframes shine { to { background-position: 200% center; } }
        
        /* Плавный скролл */
        html { scroll-behavior: smooth; }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
        
        /* Чтобы картинки не дергались при загрузке */
        .content-auto { content-visibility: auto; contain-intrinsic-size: 1px 1000px; }
    </style>
</body>
</html>
