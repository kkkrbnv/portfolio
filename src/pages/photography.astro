---
import seriesData from '../data/photos.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photography — Arslan Kurbanov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-[#000] text-[#fff] font-['Inter',sans-serif] selection:bg-white selection:text-black overflow-x-hidden">
    
    <!-- NAVIGATION -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-6 md:p-10 mix-blend-difference items-center">
        <a href="/" class="text-[10px] uppercase tracking-[0.4em] font-black border border-white/20 px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all">← Back</a>
        <span class="text-xl font-black italic tracking-tighter uppercase leading-none italic opacity-40">AK Archive</span>
    </nav>

    <main class="w-full pt-32 pb-40">
        {seriesData.map((series, sIndex) => (
            <div class="mb-40 md:mb-64">
                <!-- SERIES HEADER -->
                <header class="px-6 md:px-20 mb-20 md:mb-32">
                    <span class="text-[9px] uppercase tracking-[0.8em] text-zinc-600 block mb-4">{series.location}{'\u00A0'}</span>
                    <h2 class="text-[clamp(3rem,10vw,11rem)] font-black uppercase italic tracking-tighter pearl-text leading-[0.8] pr-20 overflow-visible">
                        {series.seriesTitle}{'\u00A0'}
                    </h2>
                </header>

                <!-- PHOTOS LIST -->
                <div class="flex flex-col items-center gap-32 md:gap-40">
                    {series.photos.map((photo, pIndex) => (
                        <div class="w-full px-4 flex justify-center" style="content-visibility: auto;">
                            <div class="relative group cursor-zoom-in" onclick={`openGallery(${sIndex}, ${pIndex})`}>
                                <!-- ФИКС: Уменьшена высота до 75vh для ПК -->
                                <img 
                                    src={photo.src} 
                                    class="max-h-[85vh] w-auto object-contain shadow-2xl transition-all duration-1000 group-hover:scale-[1.01]" 
                                    loading="lazy" 
                                />
                                {photo.description && (
                                    <div class="absolute bottom-6 left-6 opacity-0 group-hover:opacity-100 transition-all bg-black/50 backdrop-blur-xl border border-white/10 px-5 py-2 rounded-full">
                                        <p class="text-[9px] uppercase tracking-[0.3em] text-zinc-200 font-medium italic">{photo.description}{'\u00A0'}</p>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </main>

    <!-- ADVANCED GALLERY MODAL -->
    <div id="gallery-modal" class="fixed inset-0 z-[100] bg-black/98 backdrop-blur-3xl hidden flex-col items-center justify-center p-4" onclick="closeGallery()">
        
        <button class="absolute top-10 right-10 z-[110] text-white opacity-40 hover:opacity-100 text-[10px] uppercase tracking-widest transition-all">Close ×</button>

        <div class="relative w-full h-full flex flex-col items-center justify-center pointer-events-none">
            <div class="relative max-h-[85vh] max-w-[90vw] pointer-events-auto" onclick="event.stopPropagation()">
                <!-- ФИКС: В модальном окне тоже ограничили высоту для вертикальных фото -->
                <img id="modal-img" src="" class="max-h-[95vh] max-w-full object-contain shadow-2xl transition-all duration-500 scale-95" onclick="nextPhoto()" />
                
                <!-- ARROWS -->
                <button onclick="prevPhoto()" class="absolute -left-12 md:-left-20 top-1/2 -translate-y-1/2 p-4 opacity-20 hover:opacity-100 transition-all text-2xl font-light text-white">←</button>
                <button onclick="nextPhoto()" class="absolute -right-12 md:-right-20 top-1/2 -translate-y-1/2 p-4 opacity-20 hover:opacity-100 transition-all text-2xl font-light text-white">→</button>
            </div>
            
            <p id="modal-desc" class="mt-8 text-[10px] uppercase tracking-[0.4em] text-zinc-400 text-center max-w-2xl italic pointer-events-auto pr-10"></p>
        </div>

        <!-- THUMBNAILS -->
        <div id="thumb-track" class="absolute bottom-10 flex gap-2 px-10 overflow-x-auto max-w-full pointer-events-auto" onclick="event.stopPropagation()"></div>
    </div>

    <script is:inline define:vars={{ seriesData }}>
        let currentSeries = 0;
        let currentPhoto = 0;

        window.openGallery = function(sIdx, pIdx) {
            currentSeries = sIdx;
            currentPhoto = pIdx;
            updateModal();
            document.getElementById('gallery-modal').classList.remove('hidden');
            document.getElementById('gallery-modal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        window.closeGallery = function() {
            const modal = document.getElementById('gallery-modal');
            document.getElementById('modal-img').classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 300);
        }

        window.nextPhoto = function() {
            const total = seriesData[currentSeries].photos.length;
            currentPhoto = (currentPhoto + 1) % total;
            updateModal();
        }

        window.prevPhoto = function() {
            const total = seriesData[currentSeries].photos.length;
            currentPhoto = (currentPhoto - 1 + total) % total;
            updateModal();
        }

        function updateModal() {
            const photo = seriesData[currentSeries].photos[currentPhoto];
            const img = document.getElementById('modal-img');
            img.src = photo.src;
            document.getElementById('modal-desc').innerText = (photo.description || '') + '\u00A0';
            setTimeout(() => img.classList.remove('scale-95'), 10);
            renderThumbs();
        }

        function renderThumbs() {
            const track = document.getElementById('thumb-track');
            const photos = seriesData[currentSeries].photos;
            if (photos.length <= 1) { track.innerHTML = ''; return; }
            
            track.innerHTML = photos.map((p, i) => `
                <div onclick="window.setPhoto(${i})" class="w-10 h-14 md:w-12 md:h-16 flex-none cursor-pointer overflow-hidden rounded-sm transition-all border ${i === currentPhoto ? 'border-white opacity-100' : 'border-transparent opacity-30 hover:opacity-60'}">
                    <img src="${p.src}" class="w-full h-full object-cover" />
                </div>
            `).join('');
        }

        window.setPhoto = function(i) {
            currentPhoto = i;
            updateModal();
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeGallery();
            if (e.key === 'ArrowRight') nextPhoto();
            if (e.key === 'ArrowLeft') prevPhoto();
        });
    </script>

    <style is:global>
        html { scroll-behavior: smooth; background: #000; }
        .pearl-text { 
            display: inline-block; 
            background: linear-gradient(to right, #333 20%, #888 40%, #fff 50%, #888 60%, #333 80%); 
            background-size: 200% auto; 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            animation: shine 12s linear infinite; 
            padding-right: 0.2em; 
        }
        @keyframes shine { to { background-position: 200% center; } }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #1a1a1a; border-radius: 10px; }
        #thumb-track::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
