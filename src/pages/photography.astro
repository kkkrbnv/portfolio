---
import seriesData from '../data/photos.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photography — Arslan Kurbanov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-[#000] text-[#fff] font-['Inter',sans-serif] selection:bg-white selection:text-black overflow-x-hidden">
    
    <!-- NAVIGATION -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-6 md:p-10 mix-blend-difference items-center">
        <a href="/" class="text-[10px] uppercase tracking-[0.4em] font-black border border-white/20 px-6 py-2 rounded-full hover:bg-white hover:text-black transition-all">← Back</a>
        <span class="text-xl font-black italic tracking-tighter uppercase leading-none italic opacity-40">AK Archive</span>
    </nav>

    <main class="w-full pt-32 pb-40">
        {seriesData.map((series) => (
            <div class="mb-40 md:mb-64">
                <!-- ЗАГОЛОВОК СЕРИИ -->
                <header class="px-6 md:px-20 mb-20 md:mb-32 overflow-visible">
                    <span class="text-[9px] uppercase tracking-[0.8em] text-zinc-600 block mb-4">{series.location}{'\u00A0'}</span>
                    <h2 class="text-[clamp(3rem,10vw,11rem)] font-black uppercase italic tracking-tighter pearl-text leading-[0.8] pr-20 overflow-visible">
                        {series.seriesTitle}{'\u00A0'}
                    </h2>
                </header>

                <!-- СПИСОК ФОТО В СЕРИИ -->
                <div class="flex flex-col items-center gap-32 md:gap-52">
                    {series.photos.map((photo) => (
                        <div 
                            class="w-full max-w-7xl px-4 flex justify-center" 
                            style="content-visibility: auto; contain-intrinsic-size: 1px 800px;"
                        >
                            <div class="relative group cursor-zoom-in" onclick={`openPhotoModal('${photo.src}', '${photo.description}')`}>
                                <img 
                                    src={photo.src} 
                                    class="max-h-[90vh] md:max-h-[110vh] w-auto object-contain shadow-2xl transition-all duration-1000 group-hover:scale-[1.01]" 
                                    loading="lazy"
                                    decoding="async"
                                />
                                {photo.description && (
                                    <div class="absolute bottom-6 left-6 opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-2 group-hover:translate-y-0">
                                        <div class="bg-black/50 backdrop-blur-xl border border-white/10 px-5 py-2 rounded-full">
                                            <p class="text-[9px] uppercase tracking-[0.3em] text-zinc-200 font-medium italic">{photo.description}{'\u00A0'}</p>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </main>

    <!-- LIGHTBOX MODAL -->
    <div id="photo-modal" class="fixed inset-0 z-[100] bg-black/98 backdrop-blur-3xl hidden flex-col items-center justify-center p-4 md:p-10 cursor-zoom-out" onclick="closePhotoModal()">
        <img id="modal-img" src="" class="max-h-[85vh] max-w-[90vw] object-contain shadow-2xl transition-all duration-500 scale-95" />
        <p id="modal-desc" class="mt-10 text-[10px] uppercase tracking-[0.4em] text-zinc-500 text-center max-w-2xl italic pr-10 overflow-visible"></p>
    </div>

    <script is:inline>
        function openPhotoModal(src, desc) {
            const modal = document.getElementById('photo-modal');
            const img = document.getElementById('modal-img');
            img.src = src;
            document.getElementById('modal-desc').innerText = desc + '\u00A0';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            setTimeout(() => img.classList.remove('scale-95'), 10);
        }
        function closeModal() {
            const modal = document.getElementById('photo-modal');
            const img = document.getElementById('modal-img');
            img.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 300);
        }
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });
    </script>

    <style is:global>
        html { scroll-behavior: smooth; background: #000; }
        
        .pearl-text { 
            display: inline-block;
            background: linear-gradient(to right, #333 20%, #888 40%, #fff 50%, #888 60%, #333 80%); 
            background-size: 200% auto; 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            animation: shine 12s linear infinite; 
            padding-right: 0.2em; /* Фикс обрезки */
        }
        @keyframes shine { to { background-position: 200% center; } }
        
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #1a1a1a; border-radius: 10px; }
        body { scrollbar-width: thin; scrollbar-color: #1a1a1a #000; }
    </style>
</body>
</html>
