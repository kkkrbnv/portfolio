---
import showreels from '../data/showreels.json';
---
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SHOWREELS — ARSLAN KURBANOV</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-[#050505] text-[#EFEFEF] font-['Inter',sans-serif] selection:bg-white selection:text-black antialiased overflow-x-hidden border-t-2 border-white">

    <!-- ЭФФЕКТ ЗАТЕМНЕННОЙ КИНОПЛЕНКИ (DARK TINT + VIGNETTE) -->
    <div class="fixed inset-0 z-30 pointer-events-none bg-black/30 mix-blend-multiply"></div>
    <div class="fixed inset-0 z-30 pointer-events-none bg-radial-vignette"></div>

    <!-- AURA SPOTLIGHT -->
    <div id="aura" class="aura-spotlight"></div>

    <!-- HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 w-full z-50 bg-[#050505]/80 backdrop-blur-xl border-b border-zinc-900 px-6 md:px-12 py-4 flex justify-between items-center text-xs font-mono uppercase tracking-widest">
        <a href="/" class="text-white border border-zinc-800 px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all font-bold">
            ← RETURN TO ARCHIVE
        </a>
        <span class="text-zinc-500 hidden md:inline">[ 02.1 / SHOWREELS VAULT ]</span>
        <span class="font-black text-white tracking-tighter">AK®</span>
    </header>

    <main class="pt-32 px-4 md:px-12 max-w-[1600px] mx-auto pb-40 relative z-20">
        <!-- Page Title -->
        <div class="border-b border-zinc-900 pb-10 mb-16">
            <span class="text-xs font-mono uppercase tracking-[0.3em] text-zinc-500 block mb-4">[ DIRECTING & CINEMATOGRAPHY ]</span>
            <h1 class="text-[clamp(3rem,8vw,8rem)] font-black uppercase italic tracking-tighter leading-[0.85] pearl-text pr-12 overflow-visible">
                SELECTED <br /> SHOWREELS{'\u00A0'}
            </h1>
        </div>

        <!-- COMPACT MOTION GRID (АККУРАТНЫЕ ПЛАШКИ 16:9 С ЗАКРУГЛЕНИЕМ) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
            {showreels.map((reel, idx) => (
                <article class="group cursor-pointer reveal-on-scroll" onclick={`openVimeoModal('${reel.vimeoId}', '${reel.title}', '${reel.description}')`}>
                    
                    <!-- Компактная карточка 16:9 с закруглением -->
                    <div class="relative w-full aspect-video overflow-hidden rounded-2xl bg-zinc-950 border border-zinc-900 group-hover:border-zinc-500 transition-all duration-500 shadow-2xl">
                        
                        <!-- Превью видео -->
                        <video src={reel.previewVideo} class="h-full w-full object-cover opacity-50 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000 ease-out" muted loop autoplay playsinline></video>

                        <!-- Верхний индекс -->
                        <div class="absolute top-0 inset-x-0 p-6 flex justify-between items-center text-[10px] font-mono uppercase tracking-widest text-zinc-400 z-20">
                            <span class="bg-black/80 px-3 py-1 border border-zinc-800">REF 0{idx + 1}</span>
                            <span class="bg-black/80 px-3 py-1 border border-zinc-800">{reel.category}</span>
                        </div>

                        <!-- Нижняя плашка с названием -->
                        <div class="absolute bottom-0 inset-x-0 p-6 md:p-8 bg-gradient-to-t from-black via-black/40 to-transparent z-20 flex justify-between items-end">
                            <div class="overflow-visible pr-4">
                                <h2 class="text-2xl md:text-3xl font-black uppercase italic tracking-tighter text-white pearl-hover leading-none pr-4">
                                    {reel.title}{'\u00A0'}
                                </h2>
                            </div>
                            <span class="text-[10px] font-mono text-white underline opacity-0 group-hover:opacity-100 transition-opacity">PLAY VIMEO ↗</span>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <!-- VIMEO MODAL -->
    <div id="vimeo-modal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl hidden flex-col items-center justify-center p-6" onclick="closeVimeoModal()">
        <button class="absolute top-8 right-8 z-[110] text-white/50 hover:text-white font-mono text-xs uppercase tracking-widest p-4">CLOSE ×</button>

        <div class="relative w-full max-w-[85vw] aspect-video bg-black rounded-2xl overflow-hidden border border-zinc-800" onclick="event.stopPropagation()">
            <iframe id="vimeo-iframe" src="" style="position:absolute;top:0;left:0;width:100%;height:100%;" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
        </div>
        <div class="mt-8 text-center max-w-2xl px-4 font-mono uppercase tracking-widest" onclick="event.stopPropagation()">
            <h2 id="modal-title" class="text-2xl font-black italic text-white mb-2 pr-4"></h2>
            <p id="modal-desc" class="text-[10px] text-zinc-500 leading-relaxed"></p>
        </div>
    </div>

    <footer class="border-t border-zinc-900 py-8 px-6 md:px-12 flex justify-between items-center text-[10px] font-mono text-zinc-600 uppercase tracking-widest relative z-20">
        <span>[ © 2026 ARSLAN KURBANOV ]</span>
        <a href="#top" class="hover:text-white transition-colors">TOP ↑</a>
    </footer>

    <script is:inline>
        const aura = document.getElementById('aura');
        let mouseX = 0, mouseY = 0, auraX = 0, auraY = 0;
        document.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });
        function animateAura() {
            auraX += (mouseX - auraX) * 0.08; auraY += (mouseY - auraY) * 0.08;
            if (aura) aura.style.transform = `translate(${auraX - 250}px, ${auraY - 250}px)`;
            requestAnimationFrame(animateAura);
        }
        animateAura();

        function openVimeoModal(id, title, desc) {
            const modal = document.getElementById('vimeo-modal');
            const iframe = document.getElementById('vimeo-iframe');
            iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&color=ffffff&title=0&byline=0&portrait=0`;
            document.getElementById('modal-title').innerText = title + '\u00A0';
            document.getElementById('modal-desc').innerText = desc;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }
        function closeVimeoModal() {
            const modal = document.getElementById('vimeo-modal');
            const iframe = document.getElementById('vimeo-iframe');
            iframe.src = "";
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeVimeoModal(); });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('active'); });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
    </script>

    <style is:global>
        :root { color-scheme: dark; }
        html { background: #050505; }
        
        /* Радиальная виньетка плёнки */
        .bg-radial-vignette {
            background: radial-gradient(circle, transparent 50%, rgba(0,0,0,0.8) 100%);
        }

        .aura-spotlight {
            position: fixed; top: 0; left: 0; width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%; pointer-events: none; z-index: 1; filter: blur(60px);
        }

        .pearl-text { 
            display: inline-block; 
            background: linear-gradient(to right, #444 10%, #aaa 40%, #fff 50%, #aaa 60%, #444 90%); 
            background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            animation: shine 10s linear infinite; padding-right: 0.15em;
        }

        .pearl-hover { 
            background: linear-gradient(45deg, #fff, #888, #fff); 
            background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            animation: shine 2s linear infinite; 
        }

        @keyframes shine { to { background-position: 200% center; } }
        .reveal-on-scroll { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal-on-scroll.active { opacity: 1; transform: translateY(0); }
        ::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
