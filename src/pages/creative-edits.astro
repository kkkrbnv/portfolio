---
import edits from '../data/edits.json';
---
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CREATIVE EDITS — ARSLAN KURBANOV</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-[#050505] text-[#EFEFEF] font-['Inter',sans-serif] selection:bg-white selection:text-black antialiased overflow-x-hidden border-t-2 border-white">

    <!-- AURA SPOTLIGHT -->
    <div id="aura" class="aura-spotlight"></div>

    <!-- HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 w-full z-50 bg-[#050505]/80 backdrop-blur-xl border-b border-zinc-900 px-6 md:px-12 py-4 flex justify-between items-center text-xs font-mono uppercase tracking-widest">
        <a href="/" class="text-white border border-zinc-800 px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all font-bold">
            ← RETURN TO ARCHIVE
        </a>
        <span class="text-zinc-500 hidden md:inline">[ 02.2 / CREATIVE EDITS ]</span>
        <span class="font-black text-white tracking-tighter">AK®</span>
    </header>

    <main class="max-w-7xl mx-auto px-6 pt-32 pb-40">
        <!-- Page Title -->
        <div class="border-b border-zinc-900 pb-12 mb-20">
            <span class="text-xs font-mono uppercase tracking-[0.3em] text-zinc-500 block mb-4">[ COMMERCIAL & EDITORIAL EDITS ]</span>
            <h1 class="text-[clamp(3rem,10vw,10rem)] font-black uppercase italic tracking-tighter leading-[0.8] pearl-text pr-12 overflow-visible">
                CREATIVE <br /> EDITS{'\u00A0'}
            </h1>
        </div>

        <!-- Vertical List -->
        <div class="flex flex-col gap-28 md:gap-40">
            {edits.map((edit, idx) => (
                <article class="group cursor-pointer border-b border-zinc-900/80 pb-20 reveal-on-scroll" onclick={`openYouTubeModal('${edit.youtubeId}', '${edit.title}', '${edit.description}')`}>
                    <div class="flex justify-between items-end mb-6 font-mono text-xs uppercase tracking-widest">
                        <div class="overflow-visible pr-8">
                            <span class="text-zinc-500 block mb-2">EDIT 0{idx + 1} // {edit.category}</span>
                            <h2 class="text-[clamp(2rem,5vw,5rem)] font-bold uppercase  italic tracking-tighter text-white group-hover:text-zinc-400 transition-colors leading-none pr-8">
                                {edit.title}{'\u00A0'}
                            </h2>
                        </div>
                        <span class="text-zinc-600 hidden md:inline-block">PLAY VIDEO ↗</span>
                    </div>

                    <div class="relative w-full aspect-video md:aspect-[21/9] overflow-hidden rounded-none bg-zinc-950 border border-zinc-900 group-hover:border-white transition-colors duration-500">
                        <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/40 group-hover:bg-transparent transition-all">
                             <span class="px-6 py-3 bg-white text-black font-mono font-bold text-[10px] uppercase tracking-widest rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
                                WATCH YOUTUBE →
                             </span>
                        </div>
                        <video src={edit.previewVideo} class="h-full w-full object-cover opacity-50 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000 ease-out" muted loop autoplay playsinline></video>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <!-- YOUTUBE MODAL -->
    <div id="video-modal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl hidden flex-col items-center justify-center p-6" onclick="closeYouTubeModal()">
        <button class="absolute top-8 right-8 z-[110] text-white/50 hover:text-white font-mono text-xs uppercase tracking-widest p-4">CLOSE ×</button>

        <div class="relative w-full max-w-[85vw] aspect-video bg-black rounded-none overflow-hidden border border-zinc-800" onclick="event.stopPropagation()">
            <iframe id="modal-iframe" class="w-full h-full" src="" frameborder="0" allow="autoplay; fullscreen"></iframe>
        </div>
        <div class="mt-8 text-center max-w-2xl px-4 font-mono uppercase tracking-widest" onclick="event.stopPropagation()">
            <h2 id="modal-title" class="text-2xl font-black italic text-white mb-2 pr-4"></h2>
            <p id="modal-desc" class="text-[10px] text-zinc-500 leading-relaxed"></p>
        </div>
    </div>

    <footer class="border-t border-zinc-900 py-8 px-6 md:px-12 flex justify-between items-center text-[10px] font-mono text-zinc-600 uppercase tracking-widest">
        <span>[ © 2026 ARSLAN KURBANOV ]</span>
        <a href="#top" class="hover:text-white transition-colors">TOP ↑</a>
    </footer>

    <script is:inline>
        const aura = document.getElementById('aura');
        let mouseX = 0, mouseY = 0, auraX = 0, auraY = 0;
        document.addEventListener('mousemove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });
        function animateAura() {
            auraX += (mouseX - auraX) * 0.08; auraY += (mouseY - auraY) * 0.08;
            if (aura) aura.style.transform = `translate(${auraX - 250}px, ${auraY - 250}px)`;
            requestAnimationFrame(animateAura);
        }
        animateAura();

        function openYouTubeModal(id, title, desc) {
            const modal = document.getElementById('video-modal');
            const iframe = document.getElementById('modal-iframe');
            iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&modestbranding=1&rel=0`;
            document.getElementById('modal-title').innerText = title + '\u00A0';
            document.getElementById('modal-desc').innerText = desc;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }
        function closeYouTubeModal() {
            const modal = document.getElementById('video-modal');
            const iframe = document.getElementById('modal-iframe');
            iframe.src = "";
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeYouTubeModal(); });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('active'); });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
    </script>

    <style is:global>
        :root { color-scheme: dark; }
        html { background: #050505; }
        .aura-spotlight {
            position: fixed; top: 0; left: 0; width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%; pointer-events: none; z-index: 1; filter: blur(60px);
        }
        .pearl-text { 
            display: inline-block; 
            background: linear-gradient(to right, #444 10%, #aaa 40%, #fff 50%, #aaa 60%, #444 90%); 
            background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            animation: shine 10s linear infinite; padding-right: 0.15em;
        }
        @keyframes shine { to { background-position: 200% center; } }
        .reveal-on-scroll { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal-on-scroll.active { opacity: 1; transform: translateY(0); }
        ::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
