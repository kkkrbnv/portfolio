---
import projects from '../data/projects.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arslan Kurbanov — Visual Excellence</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
</head>
<body class="bg-[#000] text-[#fff] font-['Inter',sans-serif] selection:bg-zinc-500 overflow-x-hidden">
    
    <!-- NAVIGATION 2026 -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-8 mix-blend-difference items-center">
        <span class="text-2xl font-black italic tracking-tighter uppercase leading-none">AK</span>
        <div class="flex items-center gap-8 text-[9px] font-bold uppercase tracking-[0.4em]">
            <a href="https://t.me/kkkrbnv" target="_blank" class="hover:opacity-40 transition-all">Telegram</a>
            <a href="/special" class="bg-white/10 backdrop-blur-md border border-white/10 px-5 py-2 rounded-full hover:bg-white hover:text-black transition-all">Special</a>
        </div>
    </nav>

    <main class="px-6">
        <!-- HERO SECTION 2026 -->
        <section class="relative flex min-h-screen flex-col justify-center pt-20">
            <span class="text-[16px] uppercase tracking-[0.5em] text-zinc-600 mb-4 ml-2">Visual Artist</span>
            <h1 class="flex flex-col leading-[0.75] tracking-tighter uppercase italic">
                <span class="text-[10vw] font-black text-zinc-100">Arslan</span>
                
                <!-- Video Masked Surname -->
                <div class="relative group cursor-default">
                    <span class="pearl-text text-[18vw] font-[700] leading-none block">Kurbanov</span>
                    <!-- Видео, которое просвечивает сквозь текст -->
                    <video 
                        autoplay muted loop playsinline 
                        class="absolute inset-0 w-full h-full object-cover mix-blend-multiply opacity-100 pointer-events-none group-hover:opacity-20 transition-opacity duration-1000"
                        src="https://framerusercontent.com/assets/7pD9r7v8f.mp4">
                    </video>
                </div>
            </h1>
            
            <div class="mt-20 flex flex-col md:flex-row justify-between items-start md:items-end gap-12">
                <h2 class="max-w-2xl text-3xl md:text-5xl font-medium uppercase tracking-tighter leading-[0.9] text-zinc-300">
                    Visual Creator <br/> <span class="text-zinc-800">/</span> Based in Earth
                </h2>
                
                <div class="flex flex-wrap gap-3">
                    <a href="https://www.instagram.com/kkkrbnv/" target="_blank" class="btn-2026">Instagram</a>
                    <a href="https://t.me/kkkrbnv" target="_blank" class="btn-2026">Telegram</a>
                    <a href="https://www.youtube.com/@kkkrbnv" target="_blank" class="btn-2026 bg-white !text-black">YouTube</a>
                </div>
            </div>
        </section>

        <!-- CONTENT GRID -->
        <section id="work" class="grid grid-cols-1 md:grid-cols-2 gap-4 py-32">
            {projects.map((p) => (
                <a href={p.youtubeUrl} target="_blank" class="group relative aspect-video overflow-hidden rounded-[1rem] bg-zinc-950">
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-8 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-700 backdrop-blur-[2px]">
                        <span class="text-[9px] uppercase tracking-[0.5em] text-zinc-400 mb-2">{p.category}</span>
                        <h3 class="text-3xl font-black uppercase italic tracking-tighter">{p.title}</h3>
                    </div>
                    <video 
                        src={p.previewVideo} 
                        class="h-full w-full object-cover opacity-50 group-hover:opacity-100 group-hover:scale-105 transition-all duration-[1.5s] ease-out" 
                        muted loop playsinline 
                        onmouseover="this.play()" 
                        onmouseout="this.pause(); this.currentTime = 0;">
                    </video>
                </a>
            ))}
        </section>
    </main>

    <style is:global>
        :root { color-scheme: dark; }
        html { scroll-behavior: smooth; background: #000; }
        body { -webkit-font-smoothing: antialiased; }

        /* Кнопки 2026 */
        .btn-2026 {
            @apply border border-zinc-800 px-8 py-4 rounded-full text-[10px] font-bold uppercase tracking-widest hover:border-white hover:bg-white hover:text-black transition-all duration-500;
        }

        /* Эффект перламутра и видео-маски */
        .pearl-text {
            background: linear-gradient(
                45deg, 
                #1a1a1a 10%, 
                #555 30%, 
                #fff 50%, 
                #555 70%, 
                #1a1a1a 90%
            );
            background-size: 200% auto;
            color: #000; /* Текст становится прозрачным для видео через mix-blend */
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 12s linear infinite;
            filter: drop-shadow(0 0 15px rgba(255,255,255,0.1));
            opacity: 0.5;
            transition: opacity 1s ease;
        }

        .pearl-text:hover {
            opacity: 1;
            background-size: 100% auto;
        }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        /* Плавное появление контента */
        section {
            animation: reveal 1.5s cubic-bezier(0.19, 1, 0.22, 1) forwards;
        }

        @keyframes reveal {
            from { opacity: 0; transform: translateY(20px); filter: blur(10px); }
            to { opacity: 1; transform: translateY(0); filter: blur(0); }
        }

        ::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
