---
import projects from '../data/projects.json';

// Фильтруем контент по типам
const featuredProject = projects.find(p => p.isFeatured && p.type === 'video');
const motionProjects = projects.filter(p => p.type === 'video' && !p.isFeatured);
const photoProjects = projects.filter(p => p.type === 'photo');
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>Arslan Kurbanov — Visual Content Creator & Director</title>
    <meta name="description" content="Official portfolio of Arslan Kurbanov. High-end visual storytelling and cinematography." />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:title" content="Arslan Kurbanov — Visual Artist" />
    <meta property="og:image" content="https://arslankurbanov.com/og-image.jpg" />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
</head>

<body class="bg-[#000] text-[#fff] font-['Inter',sans-serif] selection:bg-zinc-800 overflow-x-hidden">
    
    <!-- NAVIGATION -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-6 md:p-10 mix-blend-difference items-center">
        <span class="text-xl font-black italic tracking-tighter uppercase">AK</span>
        <div class="flex items-center gap-6 text-[9px] font-bold uppercase tracking-[0.3em]">
            <a href="#contact" class="hover:opacity-40 transition-all border-b border-zinc-800 pb-1">Contact</a>
            <a href="/special" class="bg-white text-black px-4 py-2 rounded-full hover:bg-zinc-200 transition-all">Special</a>
        </div>
    </nav>

    <main class="px-4 md:px-10">
        <!-- HERO & MAIN SHOWREEL -->
        <section class="min-h-screen flex flex-col justify-center pt-20">
            <h1 class="flex flex-col leading-[0.8] tracking-tighter uppercase italic mb-10">
                <span class="text-[10vw] font-black text-zinc-400">Arslan</span>
                <span class="pearl-text text-[14vw] font-[900] leading-none block">Kurbanov</span>
            </h1>

            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-10 mb-10">
                <h2 class="max-w-xl text-2xl md:text-4xl font-medium uppercase tracking-tighter leading-[1.1] text-zinc-200">
                    Visual Creator <span class="text-zinc-800">/</span> Based in Earth
                </h2>
                <div class="flex flex-row flex-nowrap w-full md:w-auto gap-2">
                    <a href="https://instagram.com/kkkrbnv" target="_blank" class="btn-2026 flex-1 text-center">Instagram</a>
                    <a href="https://youtube.com/@kkkrbnv" target="_blank" class="btn-2026 flex-1 text-center bg-white !text-black">YouTube</a>
                    <a href="https://t.me/kkkrbnv" target="_blank" class="btn-2026 flex-1 text-center">Telegram</a>
                </div>
            </div>

            {featuredProject && (
                <a href={`https://www.youtube.com/watch?v=${featuredProject.youtubeId}`} target="_blank" class="group relative aspect-video w-full overflow-hidden rounded-[2rem] md:rounded-[3rem] bg-zinc-900 border border-zinc-800 shadow-2xl block">
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-8 md:p-16 bg-gradient-to-t from-black/80 via-transparent">
                        <span class="text-[10px] uppercase tracking-[0.5em] text-zinc-400 mb-4">{featuredProject.category}</span>
                        <h2 class="text-4xl md:text-7xl font-black uppercase italic tracking-tighter pearl-hover italic">Play Showreel</h2>
                    </div>
                    <img src={`https://img.youtube.com/vi/${featuredProject.youtubeId}/maxresdefault.jpg`} class="absolute inset-0 h-full w-full object-cover opacity-60 group-hover:opacity-0 transition-opacity duration-700" />
                    <video src={featuredProject.hoverVideo} class="absolute inset-0 h-full w-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-700" muted loop playsinline onmouseover="this.play()" onmouseout="this.pause(); this.currentTime = 0;"></video>
                </a>
            )}
        </section>

        <!-- MOTION SECTION -->
        <section class="py-20">
            <h3 class="text-[10px] uppercase tracking-[0.5em] text-zinc-600 mb-10 font-bold italic">Motion Works</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {motionProjects.map((p) => (
                    <a href={`https://www.youtube.com/watch?v=${p.youtubeId}`} target="_blank" class="group relative aspect-video overflow-hidden rounded-[1.5rem] bg-zinc-950 block border border-zinc-900">
                        <div class="absolute inset-0 z-20 flex flex-col justify-end p-8 bg-black/40 group-hover:bg-transparent transition-all duration-700">
                            <span class="text-[8px] uppercase tracking-[0.4em] text-zinc-400 mb-2">{p.category}</span>
                            <h3 class="text-2xl font-black uppercase italic tracking-tighter pearl-hover">{p.title}</h3>
                        </div>
                        <img src={`https://img.youtube.com/vi/${p.youtubeId}/maxresdefault.jpg`} class="absolute inset-0 h-full w-full object-cover opacity-50 group-hover:opacity-0 transition-opacity duration-500" />
                        <video src={p.hoverVideo} class="absolute inset-0 h-full w-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500" muted loop playsinline onmouseover="this.play()" onmouseout="this.pause(); this.currentTime = 0;"></video>
                    </a>
                ))}
            </div>
        </section>

        <!-- PHOTOGRAPHY SECTION -->
        <section class="py-20 border-t border-zinc-900">
            <h3 class="text-[10px] uppercase tracking-[0.5em] text-zinc-600 mb-10 font-bold italic">Photography</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                {photoProjects.map((p) => (
                    <a href={p.url || "#"} target="_blank" class="group relative aspect-[4/5] overflow-hidden rounded-2xl bg-zinc-950 block">
                        <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/60 opacity-0 group-hover:opacity-100 transition-all duration-500 backdrop-blur-sm">
                            <h3 class="text-[10px] font-black uppercase italic tracking-[0.3em] pearl-hover">{p.title}</h3>
                        </div>
                        <img src={p.previewImage} class="h-full w-full object-cover opacity-80 group-hover:opacity-100 transition-all duration-1000 group-hover:scale-105" />
                    </a>
                ))}
            </div>
        </section>

        <!-- CONTACT -->
        <section id="contact" class="py-32 border-t border-zinc-900">
            <div class="max-w-2xl">
                <h2 class="text-5xl font-black uppercase italic tracking-tighter mb-12 italic">Get in touch</h2>
                <form action="https://formspree.io/f/xnjradqk" method="POST" class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <input type="text" name="name" class="bg-transparent border-b border-zinc-800 py-4 outline-none text-xl focus:border-white transition-colors" placeholder="Name" required />
                        <input type="email" name="email" class="bg-transparent border-b border-zinc-800 py-4 outline-none text-xl focus:border-white transition-colors" placeholder="Email" required />
                    </div>
                    <button type="submit" class="w-full md:w-auto bg-white text-black px-12 py-5 rounded-full text-[10px] font-black uppercase tracking-[0.4em] hover:bg-zinc-200 transition-all">
                        Send Message
                    </button>
                </form>
            </div>
        </section>
    </main>

    <footer class="p-12 text-[9px] text-zinc-800 uppercase tracking-[0.5em] text-center italic border-t border-zinc-900/50">
        Arslan Kurbanov © 2024 — Visual Artist
    </footer>

    <style is:global>
        :root { color-scheme: dark; }
        html { scroll-behavior: smooth; background: #000; }
        .btn-2026 { @apply border border-zinc-800 px-4 md:px-8 py-4 rounded-full text-[9px] md:text-[10px] font-bold uppercase tracking-widest hover:border-white transition-all text-center flex items-center justify-center; }
        .pearl-text { background: linear-gradient(to right, #333 20%, #888 40%, #fff 50%, #888 60%, #333 80%); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 10s linear infinite; }
        .group:hover .pearl-hover { background: linear-gradient(45deg, #fff, #666, #fff); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 2s linear infinite; }
        @keyframes shine { to { background-position: 200% center; } }
        ::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
