---
import projects from '../data/projects.json';
---
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ARSLAN KURBANOV — FORMS & VISUAL ARCHIVE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content="Personal portfolio and visual archive of Arslan Kurbanov. Directing, cinematography, and digital curation." />
</head>

<body class="bg-[#080808] text-[#EFEFEF] font-['Inter',sans-serif] selection:bg-white selection:text-black antialiased overflow-x-hidden border-t-2 border-white">

    <!-- FORMS HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 w-full z-50 bg-[#080808]/90 backdrop-blur-md border-b border-zinc-900 px-6 md:px-12 py-4 flex justify-between items-center text-xs font-mono uppercase tracking-widest">
        <a href="/" class="font-black text-white text-sm tracking-tighter flex items-center gap-2">
            <span class="w-2 h-2 bg-white inline-block"></span>
            <span>ARSLAN KURBANOV</span>
        </a>
        
        <div class="flex items-center gap-8 text-[11px] text-zinc-400">
            <a href="#about" class="hover:text-white transition-colors hidden md:inline-block">01 / ABOUT</a>
            <a href="#work" class="hover:text-white transition-colors">02 / ARCHIVE</a>
            <a href="#contact" class="hover:text-white transition-colors">03 / CONTACT</a>
            <a href="/special" class="text-white border border-zinc-800 px-4 py-1.5 rounded-full hover:bg-white hover:text-black transition-all">SPECIAL</a>
        </div>
    </header>

    <main class="pt-24 px-4 md:px-12 max-w-[1900px] mx-auto">

        <!-- SECTION 01: HERO / STATEMENT (FORMS ABOUT STYLE) -->
        <section id="about" class="min-h-[85vh] flex flex-col justify-between py-12 border-b border-zinc-900">
            
            <!-- Index Line -->
            <div class="flex justify-between items-center text-[11px] font-mono uppercase tracking-[0.25em] text-zinc-500 border-b border-zinc-900/80 pb-4">
                <span>[ 01 / INDEX ]</span>
                <span class="hidden md:inline">DIRECTING / CINEMATOGRAPHY / VISUAL ARTS</span>
                <span>BASED IN EARTH</span>
            </div>

            <!-- Monumental Headline -->
            <div class="my-12">
                <h1 class="text-[13vw] md:text-[11vw] font-black uppercase tracking-tighter leading-[0.8] text-white">
                    ARSLAN<br />
                    <span class="text-zinc-700 italic font-black hover:text-white transition-colors duration-700">KURBANOV</span>
                </h1>
            </div>

            <!-- Editorial Text Columns & Social Pill Box -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end pt-8 border-t border-zinc-900/80">
                <div class="md:col-span-7">
                    <p class="text-xs md:text-sm font-mono uppercase tracking-relaxed leading-relaxed text-zinc-400 max-w-2xl">
                        Independent visual creator working across high-end commercials, creative edits, fashion films, and digital archives. Focused on raw cinematic energy and precise visual architecture.
                    </p>
                </div>
                
                <div class="md:col-span-5 flex flex-wrap md:justify-end gap-3 font-mono text-[10px] uppercase tracking-widest">
                    <a href="https://instagram.com/kkkrbnv" target="_blank" class="px-5 py-3 border border-zinc-800 rounded-full hover:bg-white hover:text-black hover:border-white transition-all">INSTAGRAM ↗</a>
                    <a href="https://vimeo.com/user259947321" target="_blank" class="px-5 py-3 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-all">VIMEO ↗</a>
                    <a href="https://t.me/kkkrbnv" target="_blank" class="px-5 py-3 border border-zinc-800 rounded-full hover:bg-white hover:text-black hover:border-white transition-all">TELEGRAM ↗</a>
                </div>
            </div>
        </section>

        <!-- CAPABILITIES / SERVICES (FORMS STUDIO FEATURE) -->
        <section class="py-16 border-b border-zinc-900 font-mono text-xs uppercase tracking-widest">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                <div class="md:col-span-3 text-zinc-500">[ CAPABILITIES ]</div>
                <div class="md:col-span-9 grid grid-cols-2 md:grid-cols-4 gap-6 text-zinc-300">
                    <div>
                        <span class="text-zinc-600 block mb-2">01 / MOTION</span>
                        <p class="font-bold text-white">COMMERCIALS</p>
                        <p class="font-bold text-white">MUSIC VIDEOS</p>
                    </div>
                    <div>
                        <span class="text-zinc-600 block mb-2">02 / DIRECTION</span>
                        <p class="font-bold text-white">CREATIVE EDITING</p>
                        <p class="font-bold text-white">COLOR GRADING</p>
                    </div>
                    <div>
                        <span class="text-zinc-600 block mb-2">03 / STILLS</span>
                        <p class="font-bold text-white">FASHION LOOKBOOKS</p>
                        <p class="font-bold text-white">STREET ARCHIVE</p>
                    </div>
                    <div>
                        <span class="text-zinc-600 block mb-2">04 / CURATION</span>
                        <p class="font-bold text-white">SPECIAL DROPS</p>
                        <p class="font-bold text-white">DIGITAL ASSETS</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 02: WORK / ARCHIVE (FORMS GRID) -->
        <section id="work" class="py-20 border-b border-zinc-900">
            
            <div class="flex justify-between items-center mb-12 text-xs font-mono uppercase tracking-widest">
                <span class="text-zinc-500">[ 02 / SELECTED MOTION ARCHIVE ]</span>
                <span class="text-zinc-600 hidden md:inline">HOVER FOR PREVIEW / CLICK FOR COLLECTION</span>
            </div>

            <!-- Editorial Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {projects.map((p, idx) => {
                    const isShowreel = p.title === "SHOWREEL";
                    const isEdit = p.title === "CREATIVE EDIT";
                    const targetLink = isShowreel ? "/showreels" : (isEdit ? "/creative-edits" : p.vimeoUrl || p.youtubeUrl);
                    const isInternal = isShowreel || isEdit;

                    return (
                        <a 
                            href={targetLink} 
                            target={isInternal ? "_self" : "_blank"}
                            class="group relative block aspect-video overflow-hidden rounded-none bg-zinc-950 border border-zinc-900 hover:border-zinc-500 transition-colors duration-500"
                        >
                            <!-- Video Loop -->
                            <video 
                                src={p.previewVideo} 
                                class="w-full h-full object-cover opacity-50 group-hover:opacity-100 transition-all duration-700 ease-out" 
                                muted 
                                loop 
                                playsinline 
                                autoplay
                            ></video>

                            <!-- Top Index Line -->
                            <div class="absolute top-0 inset-x-0 p-6 flex justify-between items-center text-[10px] font-mono uppercase tracking-widest text-zinc-400 z-20">
                                <span class="bg-black/80 px-3 py-1 border border-zinc-800">REF 0{idx + 1}</span>
                                <span class="bg-black/80 px-3 py-1 border border-zinc-800">{p.category}</span>
                            </div>

                            <!-- Bottom Title Overlay -->
                            <div class="absolute bottom-0 inset-x-0 p-6 md:p-8 bg-gradient-to-t from-black via-black/40 to-transparent z-20 flex justify-between items-end">
                                <div>
                                    <h3 class="text-2xl md:text-4xl font-black uppercase tracking-tight text-white group-hover:translate-x-2 transition-transform duration-500">
                                        {p.title}
                                    </h3>
                                </div>
                                <span class="text-[10px] font-mono uppercase tracking-widest text-white underline opacity-0 group-hover:opacity-100 transition-opacity">
                                    {isInternal ? "ENTER COLLECTION →" : "VIEW VIMEO ↗"}
                                </span>
                            </div>
                        </a>
                    );
                })}
            </div>
        </section>

        <!-- SECTION 03: PHOTOGRAPHY EXHIBITION BANNER -->
        <section class="py-20 border-b border-zinc-900">
            <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-8">
                [ 03 / STILLS ARCHIVE ]
            </div>

            <a href="/photography" class="group relative block aspect-[21/9] md:aspect-[24/7] overflow-hidden rounded-none bg-zinc-950 border border-zinc-900 hover:border-zinc-500 transition-colors duration-500">
                <img 
                    src="/photo1.jpg" 
                    alt="Photography Archive" 
                    class="w-full h-full object-cover opacity-30 group-hover:opacity-60 transition-all duration-1000 ease-out" 
                />
                
                <div class="absolute inset-0 p-8 md:p-12 flex flex-col justify-between z-20">
                    <div class="flex justify-between items-center text-[10px] font-mono uppercase tracking-widest">
                        <span class="bg-black/80 px-3 py-1 border border-zinc-800 text-zinc-400">EXHIBITION / CURATED STILLS</span>
                        <span class="bg-white text-black px-4 py-1.5 font-bold group-hover:bg-zinc-200 transition-colors">ENTER EXHIBITION →</span>
                    </div>

                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                        <h3 class="text-4xl md:text-7xl font-black uppercase tracking-tighter text-white">
                            PHOTOGRAPHY GALLERY
                        </h3>
                        <p class="text-xs font-mono uppercase tracking-widest text-zinc-400">
                            HORIZONTAL & VERTICAL SERIES
                        </p>
                    </div>
                </div>
            </a>
        </section>

        <!-- SECTION 04: CONTACT (FORMS EDITORIAL FORM) -->
        <section id="contact" class="py-28">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
                
                <div class="md:col-span-5 flex flex-col justify-between font-mono">
                    <div>
                        <span class="text-xs uppercase tracking-widest text-zinc-500 block mb-4">[ 04 / INQUIRIES ]</span>
                        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-6">WORK WITH<br />ARSLAN</h2>
                        <p class="text-xs uppercase tracking-widest text-zinc-400 leading-relaxed max-w-sm">
                            Open for direct bookings, commercial direction, and creative collaborations.
                        </p>
                    </div>
                    
                    <div class="mt-12 space-y-2 text-xs uppercase tracking-widest text-zinc-400">
                        <p>EMAIL: <a href="mailto:kkkrbnv@gmail.com" class="text-white underline">KKKRBNV@GMAIL.COM</a></p>
                        <p>TELEGRAM: <a href="https://t.me/kkkrbnv" target="_blank" class="text-white underline">@KKKRBNV</a></p>
                    </div>
                </div>

                <div class="md:col-span-7 bg-zinc-950 p-8 md:p-12 border border-zinc-900 font-mono">
                    <form action="https://formspree.io/f/xnjradqk" method="POST" class="space-y-6">
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">01 // NAME OR STUDIO</label>
                            <input 
                                type="text" 
                                name="name" 
                                required 
                                placeholder="YOUR NAME" 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors" 
                            />
                        </div>
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">02 // EMAIL ADDRESS</label>
                            <input 
                                type="email" 
                                name="email" 
                                required 
                                placeholder="EMAIL@DOMAIN.COM" 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors" 
                            />
                        </div>
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">03 // PROJECT SCOPE</label>
                            <textarea 
                                name="message" 
                                rows="3" 
                                placeholder="PROJECT DETAILS, TIMELINE, BUDGET..." 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors resize-none"
                            ></textarea>
                        </div>
                        <button 
                            type="submit" 
                            class="w-full bg-white text-black font-black uppercase text-xs tracking-widest py-5 rounded-none hover:bg-zinc-200 transition-colors"
                        >
                            SUBMIT INQUIRY →
                        </button>
                    </form>
                </div>

            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="border-t border-zinc-900 py-8 px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] font-mono text-zinc-600 uppercase tracking-widest">
        <span>[ © 2026 ARSLAN KURBANOV ]</span>
        <span>FORMS.WORLD EDITORIAL ARCHIVE</span>
        <a href="#top" class="hover:text-white transition-colors">BACK TO TOP ↑</a>
    </footer>

</body>
</html>
