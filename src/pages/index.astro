---
import projects from '../data/projects.json';
const showreel = projects.find(p => p.type === 'showreel');
const work = projects.filter(p => p.type !== 'showreel');
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arslan Kurbanov</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
</head>
<body class="bg-[#050505] text-white font-['Inter',sans-serif] selection:bg-white selection:text-black">
    
    <!-- NAVIGATION -->
    <nav class="fixed top-0 z-50 flex w-full justify-between p-6 mix-blend-difference">
        <span class="text-xl font-black italic tracking-tighter uppercase">AK®</span>
        <div class="flex items-center gap-6 md:gap-10 text-[10px] font-bold uppercase tracking-[0.3em]">
            <a href="https://t.me/kkkrbnv" target="_blank" class="hover:text-zinc-400 transition-colors">Telegram</a>
            <a href="/special" class="text-zinc-500 hover:text-white transition-colors">Special</a>
        </div>
    </nav>

    <main class="container mx-auto px-6">
        <!-- HERO SECTION -->
        <section class="flex min-h-[80vh] flex-col justify-center pt-20">
            <h1 class="text-[8vw] font-black leading-[0.8] tracking-tighter uppercase italic text-zinc-200">
                Arslan Kurbanov
            </h1>
            
            <div class="mt-10 flex flex-col md:flex-row md:items-end justify-between gap-8">
                <p class="max-w-md text-lg md:text-xl uppercase leading-[1.1] tracking-tighter font-medium text-zinc-400">
                    Visual Creator <span class="text-zinc-700">/</span> Based in Earth
                </p>
                <div class="flex gap-4">
                    <a href="https://www.instagram.com/kkkrbnv/" target="_blank" class="text-[10px] uppercase tracking-widest border border-zinc-800 px-6 py-3 rounded-full hover:border-white transition-all">Instagram</a>
                    <a href="https://www.youtube.com/@kkkrbnv" target="_blank" class="bg-white text-black px-8 py-3 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-zinc-200 transition-all">YouTube</a>
                </div>
            </div>
        </section>

        <!-- SHOWREEL SECTION (Always visible & playing) -->
        {showreel && (
            <section class="mb-8">
                <a href={showreel.link} target="_blank" class="group relative block aspect-video w-full overflow-hidden rounded-[2rem] md:rounded-[3rem] bg-zinc-900">
                    <div class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/20 group-hover:bg-transparent transition-all">
                         <div class="border border-white/20 px-6 py-2 rounded-full backdrop-blur-md text-[10px] uppercase tracking-[0.4em]">Play Showreel</div>
                    </div>
                    <video src={showreel.previewVideo} autoplay muted loop playsinline class="h-full w-full object-cover"></video>
                </a>
            </section>
        )}

        <!-- WORK GRID -->
        <section id="work" class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-32">
            {work.map((p) => (
                <a href={p.link} target="_blank" class="group relative aspect-square md:aspect-video overflow-hidden rounded-[2rem] bg-zinc-900">
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-8 bg-gradient-to-t from-black/80 via-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
                        <span class="text-[9px] uppercase tracking-[0.4em] text-zinc-400 mb-2">{p.category}</span>
                        <h3 class="text-2xl font-black uppercase italic tracking-tight">{p.title}</h3>
                    </div>
                    
                    {p.type === 'video' ? (
                        <video src={p.previewVideo} class="h-full w-full object-cover opacity-60 group-hover:opacity-100 transition-all duration-700" muted loop playsinline onmouseover="this.play()" onmouseout="this.pause(); this.currentTime = 0;"></video>
                    ) : (
                        <img src={p.image} class="h-full w-full object-cover opacity-60 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" />
                    )}
                </a>
            ))}
        </section>
    </main>

    <style is:global>
        html { scroll-behavior: smooth; background: #050505; }
        body { -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        ::-webkit-scrollbar { display: none; } /* Скрываем скролл для чистоты */
    </style>
</body>
</html>
