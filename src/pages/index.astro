---
import projects from '../data/projects.json';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arslan Kurbanov | Visuals</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;900&display=swap" rel="stylesheet">
</head>
<body class="bg-[#050505] text-white font-['Inter',sans-serif]">
    <nav class="fixed top-0 z-50 flex w-full justify-between p-8 mix-blend-difference">
        <span class="text-xl font-black italic tracking-tighter">AK®</span>
        <div class="flex gap-8 text-[10px] font-bold uppercase tracking-[0.3em]">
            <a href="#work" class="hover:opacity-50 transition-opacity">Work</a>
            <a href="https://t.me/kkkrbnv" class="text-zinc-500 hover:text-white underline underline-offset-8 transition-colors">Special</a>
        </div>
    </nav>
    <main class="px-6">
        <section class="flex min-h-screen flex-col justify-center">
            <h1 class="text-[16vw] font-black leading-[0.8] tracking-tighter uppercase italic">
                Arslan<br/><span class="text-zinc-900 hover:text-white transition-all duration-1000">Kurbanov</span>
            </h1>
            <div class="mt-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
                <p class="max-w-xs text-[11px] uppercase tracking-widest leading-loose text-zinc-500">Visual Creator / 26 y.o. <br/> Based in Earth.</p>
                <div class="flex gap-4">
                    <a href="https://www.instagram.com/kkkrbnv/" class="border border-zinc-800 px-8 py-4 rounded-full text-[10px] uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all text-center">Instagram</a>
                    <a href="https://www.youtube.com/@kkkrbnv" class="bg-white text-black px-8 py-4 rounded-full text-[10px] font-black uppercase tracking-[0.2em] hover:invert transition-all active:scale-95 text-center">YouTube</a>
                </div>
            </div>
        </section>
        <section id="work" class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-32">
            {projects.map((p) => (
                <a href={p.youtubeUrl} target="_blank" class="group relative aspect-video overflow-hidden rounded-[2.5rem] bg-zinc-900">
                    <div class="absolute inset-0 z-20 flex flex-col justify-end p-10 bg-gradient-to-t from-black/90 via-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
                        <span class="text-[10px] uppercase tracking-[0.4em] text-zinc-400 mb-2">{p.category}</span>
                        <h3 class="text-3xl font-black uppercase italic tracking-tight">{p.title}</h3>
                    </div>
                    <video src={p.previewVideo} class="h-full w-full object-cover opacity-60 group-hover:opacity-100 group-hover:scale-105 transition-all duration-1000" muted loop playsinline onmouseover="this.play()" onmouseout="this.pause(); this.currentTime = 0;"></video>
                </a>
            ))}
        </section>
    </main>
    <style is:global>
        html { scroll-behavior: smooth; background: #050505; }
        body { -webkit-font-smoothing: antialiased; overflow-x: hidden; cursor: crosshair; }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: #1a1a1a; }
    </style>
</body>
</html>
