---
import projects from '../data/projects.json';
---
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ARSLAN KURBANOV — FORMS & MOTION ARCHIVE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;500;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content="Personal portfolio and visual archive of Arslan Kurbanov." />
</head>

<body class="bg-[#050505] text-[#EFEFEF] font-['Inter',sans-serif] selection:bg-white selection:text-black antialiased overflow-x-hidden border-t-2 border-white opacity-0 transition-opacity duration-700">

    <!-- 1. ИНТЕРАКТИВНЫЙ СОФТБОКС (AURA SPOTLIGHT) -->
    <div id="aura" class="aura-spotlight"></div>

    <!-- 2. СЧЕТЧИК-ПРЕЛОАДЕР (00 -> 100%) -->
    <div id="loader" class="fixed inset-0 z-[1000] bg-[#050505] flex flex-col justify-between p-8 md:p-12 pointer-events-none font-mono">
        <div class="flex justify-between items-center text-xs text-zinc-500 uppercase tracking-widest">
            <span>[ SYSTEM INITIALIZING ]</span>
            <span>ARSLAN KURBANOV ARCHIVE</span>
        </div>
        
        <div class="my-auto text-center">
            <span id="counter" class="text-[20vw] md:text-[15vw] font-black text-white leading-none block font-mono">00</span>
        </div>

        <div class="w-full bg-zinc-900 h-[2px] relative overflow-hidden">
            <div id="progress-bar" class="absolute left-0 top-0 h-full w-0 bg-white transition-all duration-300"></div>
        </div>
    </div>

    <!-- FORMS HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 w-full z-50 bg-[#050505]/80 backdrop-blur-xl border-b border-zinc-900 px-6 md:px-12 py-4 flex justify-between items-center text-xs font-mono uppercase tracking-widest">
        <a href="/" class="font-black text-white text-sm tracking-tighter flex items-center gap-2 group">
            <span class="w-2 h-2 bg-white inline-block group-hover:scale-150 transition-transform"></span>
            <span>ARSLAN KURBANOV</span>
        </a>
        
        <div class="flex items-center gap-8 text-[11px] text-zinc-400">
            <a href="#about" class="hover:text-white transition-colors hidden md:inline-block">01 / ABOUT</a>
            <a href="#work" class="hover:text-white transition-colors">02 / ARCHIVE</a>
            <a href="#contact" class="hover:text-white transition-colors">03 / CONTACT</a>
            <a href="/special" class="text-white border border-zinc-800 px-4 py-1.5 rounded-full hover:bg-white hover:text-black transition-all font-bold">SPECIAL</a>
        </div>
    </header>

    <main class="pt-28 px-4 md:px-12 max-w-[1900px] mx-auto">

        <!-- SECTION 01: HERO / STATEMENT -->
        <section id="about" class="min-h-[85vh] flex flex-col justify-between py-12 border-b border-zinc-900 relative">
            
            <!-- Index Line -->
            <div class="flex justify-between items-center text-[11px] font-mono uppercase tracking-[0.25em] text-zinc-500 border-b border-zinc-900/80 pb-4">
                <span>[ 01 / INDEX ]</span>
                <span class="hidden md:inline">DIRECTING / CINEMATOGRAPHY / VISUAL ARTS</span>
                <span id="live-time">EARTH / 00:00</span>
            </div>

            <!-- Monumental Headline with Silver Pearl Effect -->
            <div class="my-12 perspective-container">
                <h1 id="hero-title" class="text-[13vw] md:text-[11vw] font-black uppercase tracking-tighter leading-[0.82] transition-transform duration-200 ease-out">
                    <span class="pearl-text block pr-8 overflow-visible">ARSLAN</span>
                    <span class="pearl-text italic font-black block pr-8 overflow-visible">KURBANOV</span>
                </h1>
            </div>

            <!-- Editorial Text Columns & Social Pill Box -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end pt-8 border-t border-zinc-900/80">
                <div class="md:col-span-7">
                    <p class="text-xs md:text-sm font-mono uppercase tracking-relaxed leading-relaxed text-zinc-400 max-w-2xl">
                        Independent visual creator working across high-end commercials, creative edits, fashion films, and digital archives. Focused on raw cinematic energy and precise visual architecture.
                    </p>
                </div>
                
                <div class="md:col-span-5 flex flex-wrap md:justify-end gap-3 font-mono text-[10px] uppercase tracking-widest">
                    <a href="https://instagram.com/kkkrbnv" target="_blank" class="magnetic px-6 py-3.5 border border-zinc-800 rounded-full hover:bg-white hover:text-black hover:border-white transition-all">INSTAGRAM ↗</a>
                    <a href="https://https://www.youtube.com/@kkkrbnv" target="_blank" class="magnetic px-6 py-3.5 bg-white text-black font-bold rounded-full hover:bg-zinc-200 transition-all">YouTube ↗</a>
                    <a href="https://t.me/kkkrbnv" target="_blank" class="magnetic px-6 py-3.5 border border-zinc-800 rounded-full hover:bg-white hover:text-black hover:border-white transition-all">TELEGRAM ↗</a>
                </div>
            </div>
        </section>

        <!-- CAPABILITIES / SERVICES -->
        <section class="py-16 border-b border-zinc-900 font-mono text-xs uppercase tracking-widest reveal-on-scroll">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                <div class="md:col-span-3 text-zinc-500">[ CAPABILITIES ]</div>
                <div class="md:col-span-9 grid grid-cols-2 md:grid-cols-4 gap-6 text-zinc-300">
                    <div class="p-4 border border-zinc-900/60 hover:border-zinc-700 transition-colors">
                        <span class="text-zinc-600 block mb-2">01 / MOTION</span>
                        <p class="font-bold text-white">COMMERCIALS</p>
                        <p class="font-bold text-white">MUSIC VIDEOS</p>
                    </div>
                    <div class="p-4 border border-zinc-900/60 hover:border-zinc-700 transition-colors">
                        <span class="text-zinc-600 block mb-2">02 / DIRECTION</span>
                        <p class="font-bold text-white">CREATIVE EDITING</p>
                        <p class="font-bold text-white">COLOR GRADING</p>
                    </div>
                    <div class="p-4 border border-zinc-900/60 hover:border-zinc-700 transition-colors">
                        <span class="text-zinc-600 block mb-2">03 / STILLS</span>
                        <p class="font-bold text-white">FASHION LOOKBOOKS</p>
                        <p class="font-bold text-white">STREET ARCHIVE</p>
                    </div>
                    <div class="p-4 border border-zinc-900/60 hover:border-zinc-700 transition-colors">
                        <span class="text-zinc-600 block mb-2">04 / CURATION</span>
                        <p class="font-bold text-white">SPECIAL DROPS</p>
                        <p class="font-bold text-white">DIGITAL ASSETS</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 02: WORK / ARCHIVE -->
        <section id="work" class="py-20 border-b border-zinc-900">
            
            <div class="flex justify-between items-center mb-12 text-xs font-mono uppercase tracking-widest">
                <span class="text-zinc-500">[ 02 / SELECTED MOTION ARCHIVE ]</span>
                <span class="text-zinc-600 hidden md:inline">[ HOVER FOR MOTION / CLICK TO OPEN ]</span>
            </div>

            <!-- Kinetic Motion Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {projects.map((p, idx) => {
                    const isShowreel = p.title === "SHOWREEL";
                    const isEdit = p.title === "CREATIVE EDIT";
                    const targetLink = isShowreel ? "/showreels" : (isEdit ? "/creative-edits" : p.vimeoUrl || p.youtubeUrl);
                    const isInternal = isShowreel || isEdit;

                    return (
                        <div class="motion-card-wrapper reveal-on-scroll">
                            <a 
                                href={targetLink} 
                                target={isInternal ? "_self" : "_blank"}
                                class="motion-card group relative block aspect-video overflow-hidden rounded-none bg-zinc-950 border border-zinc-900 hover:border-white transition-all duration-500"
                            >
                                <!-- Video Loop -->
                                <video 
                                    src={p.previewVideo} 
                                    class="w-full h-full object-cover opacity-40 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 ease-out" 
                                    muted 
                                    loop 
                                    playsinline 
                                    autoplay
                                ></video>

                                <!-- Top Index Badge -->
                                <div class="absolute top-0 inset-x-0 p-6 flex justify-between items-center text-[10px] font-mono uppercase tracking-widest text-zinc-400 z-20">
                                    <span class="bg-black/80 px-3 py-1 border border-zinc-800 group-hover:border-white transition-colors">REF 0{idx + 1}</span>
                                    <span class="bg-black/80 px-3 py-1 border border-zinc-800">{p.category}</span>
                                </div>

                                <!-- Floating Interactive Trigger -->
                                <div class="absolute inset-0 z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                                    <span class="px-6 py-3 bg-white text-black font-mono font-bold text-[10px] uppercase tracking-widest rounded-full shadow-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                        {isInternal ? "OPEN VAULT →" : "WATCH VIMEO ↗"}
                                    </span>
                                </div>

                                <!-- Bottom Title Overlay -->
                                <div class="absolute bottom-0 inset-x-0 p-6 md:p-8 bg-gradient-to-t from-black via-black/40 to-transparent z-20">
                                    <h3 class="text-2xl md:text-4xl font-black uppercase tracking-tight text-white group-hover:translate-x-2 transition-transform duration-500 pearl-hover">
                                        {p.title}
                                    </h3>
                                </div>
                            </a>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- SECTION 03: PHOTOGRAPHY EXHIBITION BANNER -->
        <section class="py-20 border-b border-zinc-900 reveal-on-scroll">
            <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-8">
                [ 03 / STILLS ARCHIVE ]
            </div>

            <a href="/photography" class="motion-card group relative block aspect-[21/9] md:aspect-[24/7] overflow-hidden rounded-none bg-zinc-950 border border-zinc-900 hover:border-white transition-colors duration-500">
                <img 
                    src="/photography/Fashion.jpg" 
                    alt="Photography Archive" 
                    class="w-full h-full object-cover opacity-30 group-hover:opacity-75 group-hover:scale-105 transition-all duration-1000 ease-out" 
                />
                
                <div class="absolute inset-0 p-8 md:p-12 flex flex-col justify-between z-20">
                    <div class="flex justify-between items-center text-[10px] font-mono uppercase tracking-widest">
                        <span class="bg-black/80 px-3 py-1 border border-zinc-800 text-zinc-400">EXHIBITION / CURATED STILLS</span>
                        <span class="bg-white text-black px-4 py-1.5 font-bold group-hover:bg-zinc-200 transition-colors">ENTER EXHIBITION →</span>
                    </div>

                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                        <h3 class="text-4xl md:text-7xl font-black uppercase tracking-tighter text-white pearl-hover">
                            PHOTOGRAPHY GALLERY
                        </h3>
                        <p class="text-xs font-mono uppercase tracking-widest text-zinc-400">
                            EXPLORE HORIZONTAL & VERTICAL SERIES
                        </p>
                    </div>
                </div>
            </a>
        </section>

        <!-- SECTION 04: CONTACT -->
        <section id="contact" class="py-28 reveal-on-scroll">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
                
                <div class="md:col-span-5 flex flex-col justify-between font-mono">
                    <div>
                        <span class="text-xs uppercase tracking-widest text-zinc-500 block mb-4">[ 04 / INQUIRIES ]</span>
                        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-6">WORK WITH<br />ARSLAN</h2>
                        <p class="text-xs uppercase tracking-widest text-zinc-400 leading-relaxed max-w-sm">
                            Open for direct bookings, commercial direction, and creative collaborations worldwide.
                        </p>
                    </div>
                    
                    <div class="mt-12 space-y-2 text-xs uppercase tracking-widest text-zinc-400">
                        <p>EMAIL: <a href="mailto:contact@arslankurbanov.com" class="text-white underline">CONTACT@ARSLANKURBANOV.COM</a></p>
                        <p>TELEGRAM: <a href="https://t.me/kkkrbnv" target="_blank" class="text-white underline">@KKKRBNV</a></p>
                    </div>
                </div>

                <div class="md:col-span-7 bg-zinc-950 p-8 md:p-12 border border-zinc-900 font-mono">
                    <form action="https://formspree.io/f/xnjradqk" method="POST" class="space-y-6">
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">01 // NAME OR STUDIO</label>
                            <input 
                                type="text" 
                                name="name" 
                                required 
                                placeholder="YOUR NAME" 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors" 
                            />
                        </div>
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">02 // EMAIL ADDRESS</label>
                            <input 
                                type="email" 
                                name="email" 
                                required 
                                placeholder="EMAIL@DOMAIN.COM" 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors" 
                            />
                        </div>
                        <div>
                            <label class="text-[10px] uppercase tracking-widest text-zinc-500 block mb-2">03 // PROJECT SCOPE</label>
                            <textarea 
                                name="message" 
                                rows="3" 
                                placeholder="PROJECT DETAILS, TIMELINE, BUDGET..." 
                                class="w-full bg-black/80 border border-zinc-800 rounded-none px-4 py-4 text-xs text-white focus:outline-none focus:border-white transition-colors resize-none"
                            ></textarea>
                        </div>
                        <button 
                            type="submit" 
                            class="w-full bg-white text-black font-black uppercase text-xs tracking-widest py-5 rounded-none hover:bg-zinc-200 transition-colors"
                        >
                            SUBMIT INQUIRY →
                        </button>
                    </form>
                </div>

            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="border-t border-zinc-900 py-8 px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] font-mono text-zinc-600 uppercase tracking-widest">
        <span>[ © 2026 ARSLAN KURBANOV ]</span>
        <span>PERSON BASED ON EARTH</span>
        <a href="#top" class="hover:text-white transition-colors">BACK TO TOP ↑</a>
    </footer>

    <!-- INTERACTIVE MOTION & GRAPHICS SCRIPT -->
    <script is:inline>
        // --- 1. СЧЕТЧИК ПРЕЛОАДЕРА (00 -> 100%) ---
        let count = 0;
        const counterEl = document.getElementById('counter');
        const progressEl = document.getElementById('progress-bar');
        const loader = document.getElementById('loader');

        const interval = setInterval(() => {
            count += Math.floor(Math.random() * 8) + 2;
            if (count >= 100) {
                count = 100;
                clearInterval(interval);
                setTimeout(() => {
                    loader.style.opacity = '0';
                    document.body.style.opacity = '1';
                    setTimeout(() => loader.remove(), 700);
                }, 300);
            }
            if (counterEl) counterEl.innerText = count < 10 ? '0' + count : count;
            if (progressEl) progressEl.style.width = count + '%';
        }, 35);

        // --- 2. МЯГКИЙ СОФТБОКС (AURA SPOTLIGHT) ---
        const aura = document.getElementById('aura');
        let mouseX = 0, mouseY = 0;
        let auraX = 0, auraY = 0;

        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        });

        function animateAura() {
            auraX += (mouseX - auraX) * 0.08;
            auraY += (mouseY - auraY) * 0.08;
            if (aura) {
                aura.style.transform = `translate(${auraX - 250}px, ${auraY - 250}px)`;
            }
            requestAnimationFrame(animateAura);
        }
        animateAura();

        // --- 3. 3D ПАРАЛЛАКС ЗАГОЛОВКА ПРИ ДВИЖЕНИИ МЫШКИ ---
        const heroTitle = document.getElementById('hero-title');
        document.addEventListener('mousemove', (e) => {
            if (!heroTitle) return;
            const x = (e.clientX / window.innerWidth - 0.5) * 15;
            const y = (e.clientY / window.innerHeight - 0.5) * 15;
            heroTitle.style.transform = `rotateY(${x}deg) rotateX(${-y}deg)`;
        });

        // --- 4. СКРОЛЛ-ИНЕРЦИЯ ---
        let currentScroll = window.pageYOffset;
        const cards = document.querySelectorAll('.motion-card');

        function scrollInertia() {
            let newScroll = window.pageYOffset;
            let diff = newScroll - currentScroll;
            let speed = Math.min(Math.max(diff * 0.1, -8), 8);
            
            cards.forEach(card => {
                card.style.transform = `translateY(${-speed}px)`;
            });

            currentScroll = newScroll;
            requestAnimationFrame(scrollInertia);
        }
        scrollInertia();

        // --- 5. МАГНИТНЫЕ КНОПКИ ---
        const magnetics = document.querySelectorAll('.magnetic');
        magnetics.forEach(btn => {
            btn.addEventListener('mousemove', (e) => {
                const rect = btn.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                btn.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px)`;
            });
            btn.addEventListener('mouseleave', () => {
                btn.style.transform = `translate(0, 0)`;
            });
        });

        // --- 6. ОБСЕРВЕР ПОЯВЛЕНИЯ ПРИ СКРОЛЛЕ ---
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));

        // --- 7. ЧАСЫ В РЕАЛЬНОМ ВРЕМЕНИ ---
        function updateTime() {
            const now = new Date();
            const hours = String(now.getUTCHours()).padStart(2, '0');
            const minutes = String(now.getUTCMinutes()).padStart(2, '0');
            const el = document.getElementById('live-time');
            if (el) el.innerText = `UTC / ${hours}:${minutes}`;
        }
        updateTime();
        setInterval(updateTime, 10000);
    </script>

    <style is:global>
        :root { color-scheme: dark; }
        html { scroll-behavior: smooth; background: #080808; }

        .perspective-container {
            perspective: 1000px;
        }

        .aura-spotlight {
            position: fixed; top: 0; left: 0; width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%; pointer-events: none; z-index: 1;
            filter: blur(60px); will-change: transform;
        }

        /* КЛАССИЧЕСКИЙ СЕРЕБРЯНЫЙ ПЕРЛАМУТР ДЛЯ ОБОИХ СЛОВ */
        .pearl-text { 
            display: inline-block; 
            background: linear-gradient(to right, #444 10%, #aaa 40%, #fff 50%, #aaa 60%, #444 90%); 
            background-size: 200% auto; 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            animation: shine 10s linear infinite; 
            padding-right: 0.15em;
        }

        .pearl-hover { 
            background: linear-gradient(45deg, #fff, #888, #fff); 
            background-size: 200% auto; 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent; 
            animation: shine 2s linear infinite; 
        }

        @keyframes shine { to { background-position: 200% center; } }

        .reveal-on-scroll {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-on-scroll.active {
            opacity: 1;
            transform: translateY(0);
        }

        ::-webkit-scrollbar { display: none; }
    </style>
</body>
</html>
