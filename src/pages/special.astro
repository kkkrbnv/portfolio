---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SPECIAL — ARSLAN KURBANOV</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-[#050505] text-white font-['Inter',sans-serif] flex min-h-screen flex-col items-center justify-center p-6 overflow-hidden selection:bg-white selection:text-black">
    
    <!-- Кнопка Возврата -->
    <a href="/" class="fixed top-8 left-8 font-mono text-[10px] uppercase tracking-[0.4em] text-zinc-400 hover:text-white transition-all border border-zinc-800 px-6 py-2.5 rounded-full">← RETURN</a>
    
    <!-- ИДЕАЛЬНОЕ ЦЕНТРИРОВАНИЕ ДЛЯ МОБИЛОК -->
    <div class="relative w-full max-w-5xl flex items-center justify-center text-center my-auto">
        <!-- Флеш-фоновый текст -->
        <h1 class="text-[20vw] md:text-[16vw] font-black italic tracking-tighter leading-none text-zinc-900/80 select-none uppercase w-full">
            SPECIAL
        </h1>
        
        <!-- Надпись ровно по центру -->
        <div class="absolute inset-0 flex items-center justify-center px-4 pointer-events-none">
            <span class="font-mono text-xs md:text-sm uppercase tracking-[0.6em] md:tracking-[0.8em] font-bold text-white animate-pulse text-center leading-relaxed">
                AVAILABLE SOON
            </span>
        </div>
    </div>

    <!-- Футер без скобок -->
    <div class="fixed bottom-8 font-mono text-[9px] uppercase tracking-[0.4em] text-zinc-600 text-center px-4">
        EXCLUSIVE DROPS, PRESETS & DIGITAL ASSETS / 2026 EDITION
    </div>
</body>
</html>
